      <column caption='Default Rate' datatype='real' name='[Calculation_0121592056975360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Loan Status (group)] = &apos;Bad Loan&apos; THEN [id] END)&#10;/&#10;COUNT([id])' />
      </column>
      <column caption='count(id)' datatype='integer' name='[Calculation_0121592441724929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='box 1' datatype='string' name='[Calculation_0736559783100417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='box1' datatype='string' name='[Calculation_0736559872679938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Good Loan %' datatype='real' name='[Calculation_0736560535166983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Loan Status (group)] = &apos;Good Loan&apos; THEN [id] END)&#10;/&#10;COUNT([id])' />
      </column>
      <column caption='Good Loan Apps' datatype='integer' name='[Calculation_0736560568176648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [Loan Status (group)] = &apos;Good Loan&apos; THEN [id] END)' />
      </column>
      <column caption='one' datatype='integer' name='[Calculation_2226537313333248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='GL Remaining %' datatype='real' name='[Calculation_2226537315721217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_0736560535166983]' />
      </column>
      <column caption='BL Remaining %' datatype='real' name='[Calculation_2226537327169538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Good Loan % (copy)_0736560797421580]' />
      </column>
      <column caption='Total Loan Applications' datatype='integer' name='[Calculation_4602097643884544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='MTD Loan Applications' datatype='integer' name='[Calculation_4602097646043138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF &#10;DATEDIFF(&apos;month&apos;, [issue_date], { FIXED : MAX([issue_date]) }) = 0&#10;THEN&#10;[id]&#10;END)' />
      </column>
      <column caption='MoM Loan Applications' datatype='real' name='[Calculation_4602098336100358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4602097646043138]-[MTD Total Loan Applications (copy)_4602098335342596])&#10;/&#10;[MTD Total Loan Applications (copy)_4602098335342596]' />
      </column>
      <column caption='Total Funded Amount' datatype='integer' name='[Calculation_4602098337615879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loan_amount])' />
      </column>
      <column caption='MoM Total Funded Amount' datatype='real' name='[Calculation_4602098340143115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Loan Applications (copy)_4602098338566152]- [MTD Total Funded Amount (copy)_4602098339438601])&#10;/&#10;[MTD Total Funded Amount (copy)_4602098339438601]' />
      </column>
      <column caption='Total Amount Received' datatype='integer' name='[Calculation_4602098342420492]' role='measure' type='quantitative'>
