              <calculation class='tableau' formula='COUNT([id])' />
            </column>
            <column caption='Bad Loan Funded Amount ' datatype='integer' name='[Good Loan Funded Amount  (copy)_0736560824684561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Loan Status (group)] = &apos;Bad Loan&apos; THEN [loan_amount] END)' />
            </column>
            <column datatype='string' name='[Loan Status (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[loan_status]' new-bin='true'>
                <bin default-name='false' value='&quot;Bad Loan&quot;'>
