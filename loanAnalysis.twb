          <zone fixed-size='149' forceUpdate='true' h='17445' id='48' is-fixed='true' type-v2='text' w='34938' x='23375' y='71778'>
            <formatted-text>
              <run fontsize='14'>• Default rate increased by </run>
              <run bold='true' fontsize='14'>+2.3%</run>
              <run fontsize='14'> MoM</run>
              <run>Æ&#10;</run>
              <run fontsize='14'>• Debt consolidation has highest risk</run>
              <run>Æ&#10;</run>
              <run fontsize='14'>• CA &amp; TX contribute </run>
              <run bold='true' fontsize='14'>45%</run>
